# Copiar a .env y reemplazar ambos valores antes del primer arranque.
DJANGO_SECRET_KEY=CAMBIAR-por-un-secreto-aleatorio-de-al-menos-50-caracteres
POSTGRES_PASSWORD=CAMBIAR-por-una-clave-local-aleatoria
POSTGRES_DB=gestion_concursos
POSTGRES_USER=concursos
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Solo True cuando se sirve por HTTPS; desarrollo local usa HTTP.
DJANGO_HTTPS=False
